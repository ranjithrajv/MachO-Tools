{
  "name": "macho-tools",
  "version": "0.1.0",
  "type": "module",
  "description": "Mach-O binary introspection for Apple binaries: fat headers, symbol search, vaddr lookup, address-to-offset mapping, direct-call xrefs and byte-literal search. Zero dependencies, no build step — and it reads Mac binaries from Linux or Windows.",
  "keywords": [
    "mach-o",
    "macho",
    "universal-binary",
    "binary-analysis",
    "reverse-engineering",
    "arm64",
    "x86-64",
    "fat-binary",
    "symbol-table"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranjithrajv/MachO-Tools.git"
  },
  "bugs": {
    "url": "https://github.com/ranjithrajv/MachO-Tools/issues"
  },
  "homepage": "https://github.com/ranjithrajv/MachO-Tools#readme",
  "author": "ranjithrajv",
  "license": "LGPL-3.0-or-later",
  "main": "src/api.mjs",
  "exports": {
    ".": "./src/api.mjs",
    "./macho": "./src/macho.mjs",
    "./fixtures": "./test/fixtures.mjs",
    "./package.json": "./package.json"
  },
  "types": "src/api.d.ts",
  "files": [
    "src",
    "test/fixtures.mjs",
    "test/fixtures",
    "man",
    "completions",
    "skill",
    "config.json",
    "COPYING",
    "LICENSE",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "man": [
    "man/man1/macho-describe.1",
    "man/man1/macho-sym.1",
    "man/man1/macho-symlookup.1",
    "man/man1/macho-findcall.1",
    "man/man1/macho-findliteral.1",
    "man/man1/macho-mapliteral.1",
    "man/man1/macho-a2o.1",
    "man/man1/macho-o2a.1",
    "man/man1/macho-mcp.1"
  ],
  "bin": {
    "macho-describe": "src/describe.mjs",
    "macho-sym": "src/sym.mjs",
    "macho-symlookup": "src/symlookup.mjs",
    "macho-findcall": "src/findcall.mjs",
    "macho-findliteral": "src/findliteral.mjs",
    "macho-mapliteral": "src/mapliteral.mjs",
    "macho-a2o": "src/a2o.mjs",
    "macho-o2a": "src/o2a.mjs",
    "macho-mcp": "src/mcp.mjs"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "test:fixtures": "node test/fixtures.mjs",
    "test:mutation": "node test/mutation-check.mjs",
    "test:mcp": "node test/mcp.mjs",
    "test:skill": "node test/skill.mjs",
    "test:publish": "node test/publish.mjs",
    "test:all": "npm run test:fixtures && npm test && npm run test:mcp && npm run test:skill && npm run test:publish && npm run test:mutation"
  },
  "engines": {
    "node": ">=22.15"
  }
}
